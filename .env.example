# Copie este arquivo para .env e preencha com a URL do Supabase.
# No Render, cadastre esta mesma variavel em Environment.
SUPABASE_DB_URL=postgresql://postgres:SUA_SENHA@db.PROJETO.supabase.co:5432/postgres

# Gere uma chave longa e aleatoria para as sessoes do Flask.
SECRET_KEY=troque-por-uma-chave-aleatoria

# Em producao, use a URL PostgreSQL do Supabase em Connect > ORMs > Python.
# Nunca publique esta URL: ela pode conter a senha do banco.
